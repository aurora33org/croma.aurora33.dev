# ========================================
# Server Configuration
# ========================================
# PORT is injected automatically by most hosts (e.g. Railway). Default 3000 locally.
PORT=3000
NODE_ENV=production

# ========================================
# Upload Limits (single set, no tiers)
# Build-time vars — set BEFORE the build to take effect.
# If omitted, defaults are 100 files / 100 MB per file.
# ========================================
# Maximum number of files per batch (default: 100)
# NEXT_PUBLIC_MAX_FILES=100

# Maximum file size per image in whole MB (default: 100)
# NEXT_PUBLIC_MAX_FILE_MB=100

# ========================================
# Cleanup Configuration
# ========================================
# Interval for cleanup job in minutes (runs every N minutes)
CLEANUP_INTERVAL=15

# Time To Live for files in seconds (3600 = 1 hour)
# Files older than this are automatically deleted
FILE_TTL=3600
